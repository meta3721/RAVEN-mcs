{
  "canonical_pair_id": "client_id::target_group",
  "formula": {
    "Delta_pair": "||Pi_hat - pi_tar||_1 on common canonical support",
    "Pi_hat_pair": "(1/S_R) sum_r eta_r I_r alpha_{k,r}^{(m)} w_{k,r,i}^{(m)} mapped to (client, target_group)",
    "code": "raven_mcs.e3.target_pair.pair_state_v4.accumulate_pair_state_v4"
