    "dataset",
    "seed",
    "scenario",
    "method",
    "window",
    "client_id",
    "raw_atomic_unit_id",
    "canonical_pair_id",
    "spatial_unit",
    "time_block",
    "target_group",
    "eta_r",
    "I_r",
    "alpha_client",
    "w_atomic",
    "contribution",
    "accumulated_pair_mass",
    "target_pair_mass",
    "support_mask",
    "normalization_denominator",
    "eventtrace_hash",
    "target_artifact_hash",
    "method_source_hash",
    "schema_version"
  ],
  "schema_version": "E3_PAIR_STATE_SCHEMA_V4"
}
