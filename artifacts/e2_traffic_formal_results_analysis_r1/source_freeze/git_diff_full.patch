+#!/usr/bin/env python3
+"""E2-TRAFFIC-FORMAL-RUNS-R1 prepare CLI (preflight / eventtrace / run-one / finalize)."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
