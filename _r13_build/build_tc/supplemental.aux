\@writefile{lot}{\contentsline {table}{\numberline {XX}{\ignorespaces Coverage-stress audit of a candidate aggregate coverage Gate. Validity is the fraction of CERTIFIED windows with $C^{\mathrm  {LCB}}\le C$. FSR is the false-safe rate among CERTIFIED windows with $C<\tau _{\mathrm  {cov}}$. Gate ON is the fraction of all windows with $\mathrm  {Gate}_t=1$. SensorScope $a=0.40$ and U-Air $a=0.20$ keep Gate off because the LCB stays below $\tau _{\mathrm  {cov}}$. U-Air $a=1.00$ misses the nominal $95\%$ empirical validity.}}{15}{}\protected@file@percent }
\newlabel{tab:certificate_stress}{{XX}{15}{}{table.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XXI}{\ignorespaces Target-coverage statistic per block, and the Design factor setting the support gate (42) returns for that block's ranking. Zero test: frozen $\pi ^{\mathrm  {tar}}(k(i),s(i))$ for the occupancy-attached client; a missing key is $0$. The gate sets Design on exactly when this statistic is zero, and it does not verify positivity on target-positive pairs. The setting is a configuration fixed before the window opens, reported together with the ranking it produced. U-Air $25.5\%$ is EventTrace occurrence, not this statistic.}}{15}{}\protected@file@percent }
\newlabel{tab:scd_phi_freeze}{{XXI}{15}{}{table.21}{}}
